{
  "name": "lifeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern life timeline app with Vue, TypeScript, Tailwind and a small SQLite backend.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@vueuse/core": "^13.3.0",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0",
    "postcss": "^8.5.4",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
