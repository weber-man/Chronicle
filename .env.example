# Copy to .env and fill in the values before starting the app.
NODE_ENV=development
PORT=3001
DB_PATH=./data/lifeline.sqlite

# Generate with: openssl rand -hex 48
# Leave empty to use the persisted data/.jwt-secret file instead.
JWT_SECRET=

# Required on the first start. At least 12 characters; known defaults are rejected.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_COLOR="#7c3aed"

# Registration is disabled unless explicitly enabled.
ALLOW_REGISTRATION=false

CORS_ORIGINS=
TRUST_PROXY=
LOG_REQUESTS=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
